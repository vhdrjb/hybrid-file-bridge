# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
AUTHORIZED_USERS=123456789,987654321

# Provider Priority (comma-separated, first tried first)
# Available: ArvanCloud, Liara, ParsaSpace, Bale, Eitaa, PicoFile
PROVIDER_PRIORITY=ArvanCloud,Liara,ParsaSpace,Bale,Eitaa,PicoFile

# ── ArvanCloud Object Storage ──────────────────────────────────
# S3-compatible storage.  50 GB free bandwidth, 1M requests/month.
# Panel → Settings → Machine User → Create Access Key.
ARVAN_ACCESS_KEY=your_access_key
ARVAN_SECRET_KEY=your_secret_key
ARVAN_BUCKET=your-bucket-name
# Region endpoint (default: s3.ir-thr-at1.arvanstorage.ir)
ARVAN_ENDPOINT=s3.ir-thr-at1.arvanstorage.ir
# Delete objects older than N days (0 = disabled)
ARVAN_VALID_DAYS=2

# ── Liara Object Storage ───────────────────────────────────────
# Presigned-URL based storage.  Limited free tier, then PAYG.
# Get your API key from https://console.liara.ir
LIARA_API_KEY=your_liara_api_key
LIARA_BUCKET=your-bucket-name
# Delete objects older than N days (0 = disabled)
LIARA_VALID_DAYS=2

# ── PicoFile ───────────────────────────────────────────────────
# File-sharing service.  20 GB storage, ~2 GB per file.
# Uses reverse-engineered web API — may break without notice.
PICOFILE_EMAIL=your_email@example.com
PICOFILE_PASSWORD=your_password
# Delete files older than N days (0 = disabled)
PICOFILE_VALID_DAYS=2

# ── Bale Messenger Configuration ───────────────────────────────
# Get your token from @BotFather on Bale (https://ble.ir)
BALE_BOT_TOKEN=bale_token
BALE_CHAT_ID=@channel_username

# ── Eitaa Messenger Configuration ──────────────────────────────
# Get your token from EitaaYar (https://web.eitaayar.com)
EITAA_BOT_TOKEN=eitaa_token
EITAA_CHAT_ID=123456789

# ── ParsaSpace Configuration ───────────────────────────────────
# Get your API token from https://parsaspace.com
PARSASPACE_TOKEN=parsaspace_api_token
PARSASPACE_DOMAIN=your-subdomain.parsaspace.com

# Upload Settings (in MB)
SINGLE_UPLOAD_MAX_MB=450
RAR_VOLUME_SIZE_MB=450

# Per-provider max upload sizes (in MB)
# These override the defaults if a provider has a stricter limit.
ARVAN_MAX_UPLOAD_MB=5120
LIARA_MAX_UPLOAD_MB=5120
PICOFILE_MAX_UPLOAD_MB=2048
BALE_MAX_UPLOAD_MB=50
EITAA_MAX_UPLOAD_MB=50
PARSASPACE_MAX_UPLOAD_MB=51200

# Timezone
TZ=Asia/Tehran
